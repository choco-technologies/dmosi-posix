# DMOD Resource File for dmosi-posix
# This file specifies where resources should be installed / packaged.
# dmosi-posix ships as a plain static library (not a loadable DMOD module),
# built for x86_64 POSIX hosts.

# === Static Library ===
# Precompiled static library (x86_64 POSIX build)
lib=./lib/libdmosi_posix.a => ${destination}/${module}/lib/libdmosi_posix.a [origin=${build_dir}/libdmosi_posix.a]

# === Documentation ===
readme=./README.md => ${destination}/${module}/README.md [origin=${repo_dir}/README.md]

# === License ===
license=./LICENSE => ${destination}/${module}/LICENSE [origin=${repo_dir}/LICENSE]

# Adding itself
dmr=./dmosi-posix.dmr => ${destination}/${module}/dmosi-posix.dmr [origin=${repo_dir}/dmosi-posix.dmr]
